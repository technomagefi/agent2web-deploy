{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent2web",
  "main": "build/src/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // One address, on purpose. This Worker is its own OAuth authorization server
  // and it learns its issuer from the first request the owner authenticates on,
  // so every extra origin it answers to is a chance to pin the wrong one. Both
  // of these are Cloudflare's defaults; naming them keeps the default from
  // drifting and silences the deploy-time warnings about leaving them unset.
  "workers_dev": true,
  "preview_urls": false,

  // ---------------------------------------------------------------------
  // This fork is the deployment source for a2w.koodiorja.com. Everything
  // below this line differs from upstream on purpose: upstream ships a
  // placeholder id because it cannot know anyone's account, and a real
  // deployment has to name its own resources.
  //
  // To take upstream changes:  git fetch upstream && git merge upstream/main
  // Shared history makes that a fast-forward; the only file that can ever
  // conflict is this one, and only when upstream edits it.
  // ---------------------------------------------------------------------
  // Two bindings, no KV: OAuth tokens live in D1 alongside the sites,
  // because agent2web brings its own authorization server.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent2web",
      "database_id": "fdc5ccbf-08ff-499b-84c9-94b04da8b2d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "agent2web-sites",
      "preview_bucket_name": "agent2web-sites"
    }
  ],

  "vars": {
    // Deliberately absent: A2W_PUBLIC_URL. Nobody can know their Worker's URL
    // before deploying, so the Worker learns it from the first request and
    // remembers it. Set it explicitly when you attach a custom domain.

    // Workers allows a 100 MB request body but only 128 MB of isolate memory,
    // and a site arrives base64-inflated before being decoded.
    "A2W_MAX_SITE_BYTES": "26214400",
  },

  // Secrets, never vars: A2W_SECRET, A2W_ADMIN_PASSWORD (or
  // A2W_ADMIN_PASSWORD_HASH), and optionally A2W_API_TOKEN and
  // A2W_ADMIN_TOTP_SECRET. `npm run gen-secrets` prints all of them.

  "triggers": {
    // Expired authorization requests, spent codes, dead tokens and stale login
    // attempt counters are only ever garbage.
    "crons": ["0 4 * * *"]
  },

  "observability": { "enabled": true }
}
